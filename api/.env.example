# ---------------------------------------------------------------------------
# Variables de entorno de la API de Vina y Bodega
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es real. Los secretos se generan con:
#
#   php artisan key:generate --show
#
# Las variables `VINA_*` son opcionales: si no se definen, se usan los
# valores por omision de `config/vina.php`.
# ---------------------------------------------------------------------------

APP_NAME="Viña Hefesto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# El rol de esta conexion NO puede ser superusuario ni tener BYPASSRLS.
# Con cualquiera de las dos, PostgreSQL ignora las politicas de Row Level
# Security y una viña podria ver los datos de otra. Lo comprueba:
#   php artisan vina:verificar-aislamiento
DB_CONNECTION=pgsql
DB_DATABASE=vina
DB_USERNAME=vina_app
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION, y lo crea el script de arranque
# `deploy/postgres/inicializar-rol.sh`. Este es el de ARRANQUE: la imagen
# oficial lo crea superusuario, asi que la aplicacion NUNCA conecta con el. Con
# superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# vina podria ver los datos de otra. Los dos detalles, en docs/03.
#
# Es un secreto DISTINTO del de `DB_PASSWORD`.
DB_ADMIN_USERNAME=vina_admin
DB_ADMIN_PASSWORD=

# Solo en produccion: Redis exige contrasena.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Authentik (proveedor de identidad)
# ---------------------------------------------------------------------------
AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/vina/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/acceso/callback
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_ALGORITMO=RS256
AUTHENTIK_GRUPO_ADMIN=vina-administradores
AUTHENTIK_GRUPO_OPERADORES=vina-operadores

# ---------------------------------------------------------------------------
# Reglas de la viña (opcionales)
# ---------------------------------------------------------------------------

# Brix por omision cuando una vendimia NO tiene analisis registrado.
#
# OJO: el valor por omision es NULO a proposito. Un numero inventado seria un
# analisis de laboratorio que nadie hizo, y el brix decide cuando se destaja.
# Ver docs/05.
VINA_BRIX_POR_DEFECTO=

# Acidez por omision, misma regla que el brix: si no se midio, no se escribe.
VINA_ACIDEZ_POR_DEFECTO=

# Kilos de diferencia que se aceptan entre lo declarado y lo pesado antes de
# avisar. Solo informa: no corrige el peso.
VINA_TOLERANCIA_KILOS=0

# Dias sin actividad antes de avisar que un lote lleva mucho tiempo parado.
# Es solo una ventana de aviso: un lote con una guarda larga en barrica es
# una operacion legitima y el sistema informa, no decide.
VINA_DIAS_AVISO_SIN_ACTIVIDAD=30

# Minutos que puede esperar una venta antes de que se rechace por el tiempo
# de espera. No bloquea el cobro: el servicio avisa con un codigo estable.
VINA_MINUTOS_MAXIMOS_VENTA=30

# Poner en "true" solo en desarrollo: el entrypoint corre las migraciones
# automaticamente. En produccion se aplican a mano, una vez.
VINA_CORRER_MIGRACIONES=false