# ---------------------------------------------------------------------------
# Variables de despliegue de Vina y Bodega.
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es real. Copiar a `.env` y reemplazar TODO.
#
#   cp .env.example .env
#
# Para generar `APP_KEY`:
#
#   docker compose -f docker-compose.prod.yml run --rm api php artisan key:generate --show
#
# Ver docs/04-INSTALACION.md.
# ---------------------------------------------------------------------------

# --- Direcciones -----------------------------------------------------------
# Son las URLs PUBLICAS: las que las personas usan.

# URL de la API.
APP_URL=https://api.vina.ejemplo.cl

# URL de la interfaz. Es la que se usa para los enlaces y para redirigir al
# proveedor de identidad.
APP_WEB_URL=https://vina.ejemplo.cl

# --- Secretos --------------------------------------------------------------
# Los tres son OBLIGATORIOS. El `docker-compose.prod.yml` se niega a arrancar
# si falta alguno: `?` en la variable lo hace explicito.

# Clave de la aplicacion. Se genera con el comando de arriba.
APP_KEY=cambiar-generar-con-key-generate-show

# Contrasena de la base de datos.
DB_PASSWORD=cambiar-esta-contrasena

# Contrasena de Redis. Sin esto, Redis acepta cualquier conexion.
REDIS_PASSWORD=cambiar-esta-contrasena

# --- Proveedor de identidad -------------------------------------------------
# Authentik. El issuer debe terminar en barra.

AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/vina/
AUTHENTIK_CLIENT_ID=cambiar-por-el-id-real
AUTHENTIK_CLIENT_SECRET=cambiar-por-el-secreto-real
AUTHENTIK_REDIRECT_URI=https://api.vina.ejemplo.cl/api/v1/acceso/callback

# --- Respaldos --------------------------------------------------------------
# Carpeta donde los scripts de respaldo dejan los paquetes. Tiene que estar
# montada dentro del contenedor de la base, que en `docker-compose.prod.yml` la
# recibe en `/respaldos`.
VINA_RESPALDOS=/respaldos

# --- Reglas de la viña (opcionales) ----------------------------------------
#
# Ver docs/05-CONFIGURACION.md.

# Dias sin actividad antes de avisar que un lote lleva mucho tiempo parado.
# Es solo una ventana de aviso: un lote con una guarda larga en barrica es
# una operacion legitima y el sistema informa, no decide.
# VINA_DIAS_AVISO_SIN_ACTIVIDAD=30

# Minutos que puede esperar una venta antes de que se avise.
# **Pendiente de confirmar con la viña.**
# VINA_MINUTOS_MAXIMOS_VENTA=30

# Brix y acidez por omision cuando una vendimia no tiene analisis.
# Se dejan VACIOS a proposito: un numero inventado seria un analisis de
# laboratorio que nadie hizo. Ver docs/05.
# VINA_BRIX_POR_DEFECTO=
# VINA_ACIDEZ_POR_DEFECTO=