# ---------------------------------------------------------------------------
# Variables de entorno de la capa web
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es real.
#
# Estas variables las lee SOLO el servidor de Nuxt. Nunca se mandan al
# navegador: la cookie de sesion viaja sola y el resto de la comunicacion
# pasa por el servidor intermedio.
# ---------------------------------------------------------------------------

# A donde vive la API. Desde el CONTENEDOR de la web, nunca "localhost":
# cada contenedor tiene su propia red y su propio localhost.
NUXT_API_BASE=http://api:8000

# URL publica de la interfaz. Se usa para redirigir al proveedor de
# identidad y para los enlaces de la aplicacion.
NUXT_PUBLIC_URL=http://localhost:3000

# URL publica de la API. Solo para enlaces que se muestran a la persona.
NUXT_PUBLIC_API_BASE=http://localhost:8000